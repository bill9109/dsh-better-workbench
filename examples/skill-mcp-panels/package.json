{
  "name": "dsh-better-workbench-skill-mcp-panels",
  "version": "0.1.0",
  "description": "Two-page Workbench example ported from Fishquito7/dsh-skill-mcp-panel: a Skills manager page and an MCP server manager page.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.5",
    "dsh-better-workbench": "^0.3.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.5",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "dsh-better-workbench": "workspace:^",
    "react": "18.2.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chokidar": "^5.0.0",
    "fflate": "^0.8.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dry-run": "node scripts/build.mjs --dry-run",
    "build:verify": "node scripts/build.mjs --verify",
    "check": "node scripts/build.mjs --check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-workbench",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
